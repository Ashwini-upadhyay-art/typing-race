# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typing_race?schema=public"

# Public URL of the socket.io server (used by the browser)
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Port the socket server listens on
SOCKET_PORT=4000

# Origin allowed by the socket server CORS
CLIENT_ORIGIN="http://localhost:3000"
