# Pusher Channels — get from https://dashboard.pusher.com (free Sandbox plan)
# Server-side (used by /api/pusher/auth — do NOT expose to client)
PUSHER_APP_ID="123456"
PUSHER_KEY="abcdef0123456789"
PUSHER_SECRET="0123456789abcdef"
PUSHER_CLUSTER="mt1"

# Client-side (NEXT_PUBLIC_ → bundled into the browser, safe to expose)
NEXT_PUBLIC_PUSHER_KEY="abcdef0123456789"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
