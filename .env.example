# =============================================================================
# Local dev (.env)
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typing_race?schema=public"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
SOCKET_PORT=4000
CLIENT_ORIGIN="http://localhost:3000"

# =============================================================================
# Production examples
# =============================================================================
# On Vercel (frontend) — set these in the project's Environment Variables UI:
#   DATABASE_URL           → Neon connection string (use the pooled URL for serverless)
#   NEXT_PUBLIC_SOCKET_URL → https://your-app.fly.dev
#
# On Fly.io (socket server) — set with `fly secrets set ...`:
#   DATABASE_URL    → Neon connection string (direct URL is fine for a long-running server)
#   CLIENT_ORIGIN   → https://your-vercel-app.vercel.app  (comma-separate to allow more)
#
# CLIENT_ORIGIN accepts a comma-separated list, e.g.
#   CLIENT_ORIGIN="https://neontype.vercel.app,https://www.example.com"
