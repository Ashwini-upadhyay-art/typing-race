{
  "name": "typing-race",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,ws -c cyan,magenta \"next dev -p 3000\" \"npm run dev:server\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "prisma generate && next build && tsc -p tsconfig.server.json",
    "start": "concurrently -n web,ws -c cyan,magenta \"next start -p 3000\" \"node dist/server/index.js\"",
    "start:server": "node dist/server/index.js",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.11.17",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
